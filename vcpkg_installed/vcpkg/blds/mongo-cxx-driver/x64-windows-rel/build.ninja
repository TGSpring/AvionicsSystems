# =============================================================================
# Object build statements for EXECUTABLE target microbenchmarks


#############################################
# Order-only phony target for microbenchmarks

build cmake_object_order_depends_target_microbenchmarks: phony || cmake_object_order_depends_target_bsoncxx_shared cmake_object_order_depends_target_mongocxx_shared

